export PATH="/opt/homebrew/bin:$PATH"

COMMAND=$1

case "$COMMAND" in
  test)
    echo "========================================="
    echo "🚀 Running twin-cities-concierge-agent evaluations..."
    echo "========================================="
    agents-cli eval run
    ;;
  deploy)
    STAGE=${2:-production}
    if [ "$STAGE" = "staging" ]; then
      DISPLAY_NAME="Twin Cities Concierge Agent (Staging)"
      echo "========================================="
      echo "🚀 Deploying to Staging..."
      echo "========================================="
    else
      DISPLAY_NAME="Twin Cities Concierge Agent"
      echo "========================================="
      echo "🚀 Deploying to Production..."
      echo "========================================="
    fi
    uv run --with pyyaml --with google-agents-cli==0.1.3 python deploy.py "$STAGE" "$DISPLAY_NAME"
    ;;
  mender)
    shift || true
    SUBCOMMAND=${1:-demo}
    echo "========================================="
    echo "🛡️  Running CodeMender ($SUBCOMMAND)..."
    echo "========================================="
    if [[ "$SUBCOMMAND" == -* ]]; then
      python3 scripts/codemender.py demo "$SUBCOMMAND" "$@"
    else
      shift || true
      python3 scripts/codemender.py "$SUBCOMMAND" "$@"
    fi
    ;;
  review)
    shift || true
    echo "========================================="
    echo "🛡️  Running CodeMender Review (demo)..."
    echo "========================================="
    python3 scripts/codemender.py demo "$@"
    ;;
  *)
    echo "Usage: ./agent {test|deploy|mender|review}"
    echo "  ./agent test                - Run agent evaluations"
    echo "  ./agent deploy [staging]    - Deploy to Vertex AI Agent Engine"
    echo "  ./agent mender [cmd]        - Run CodeMender (find, verify, fix, demo)"
    echo "  ./agent review              - Run interactive CodeMender demo workflow"
    exit 1
    ;;
esac
